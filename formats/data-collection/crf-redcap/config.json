{
  "formatId": "data-collection.crf-redcap",
  "displayName": "Case Report Form (REDCap layout)",
  "phaseId": "data-collection",
  "version": "v1",
  "templateFile": "template.dotx",
  "page": {
    "size": "letter",
    "widthTwips": 12240,
    "heightTwips": 15840,
    "orientation": "portrait",
    "margins": {
      "topTwips": 1440,
      "rightTwips": 1440,
      "bottomTwips": 1440,
      "leftTwips": 1440
    }
  },
  "typography": {
    "defaultFont": "Arial",
    "defaultSizePt": 10,
    "defaultLineSpacing": "single",
    "defaultAlignment": "left",
    "language": null
  },
  "headings": {
    "1": {
      "wordStyle": "CRF Section 1"
    },
    "2": {
      "wordStyle": "CRF Section 2"
    },
    "3": {
      "wordStyle": "CRF Section 3"
    },
    "4": {
      "wordStyle": "CRF Section 4"
    },
    "5": {
      "wordStyle": "CRF Section 5"
    },
    "6": {
      "wordStyle": "CRF Section 6"
    }
  },
  "styleMap": {
    "title": "CRF Title",
    "subtitle": "CRF Subtitle",
    "paragraph": "CRF Body",
    "list:bullet": "CRF Bullet",
    "list:ordered": "CRF Numbered",
    "table": "CRF Grid",
    "tableHeader": "CRF Grid Header",
    "figure": "CRF Figure",
    "caption": "CRF Caption",
    "blockquote": "CRF Note",
    "codeBlock": "CRF Code",
    "toc:1": "CRF Contents Entry",
    "toc:2": "CRF Contents Entry",
    "toc:3": "CRF Contents Entry",
    "footnote": "CRF Footnote",
    "custom:crfField": "CRF Field Label"
  },
  "toc": {
    "enabled": false,
    "depth": 0,
    "autoGenerateFromHeadings": true
  },
  "headingNumbering": {
    "auto": false,
    "note": "Headings use direct Word styles only; no automatic multilevel numbering is linked to them."
  },
  "citationStyle": "none",
  "pageNumbering": "arabic",
  "docFeatures": {
    "coverPage": false,
    "header": "{documentTitle} — {projectId}",
    "footer": "Page"
  }
}
