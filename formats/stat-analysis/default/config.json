{
  "formatId": "stat-analysis.default",
  "displayName": "Statistical Analysis Report",
  "phaseId": "stat-analysis",
  "version": "v1",
  "templateFile": "template.dotx",
  "page": {
    "size": "letter",
    "widthTwips": 12240,
    "heightTwips": 15840,
    "orientation": "portrait",
    "margins": {
      "topTwips": 1440,
      "rightTwips": 1440,
      "bottomTwips": 1440,
      "leftTwips": 1440
    }
  },
  "typography": {
    "defaultFont": "Calibri",
    "defaultSizePt": 11,
    "defaultLineSpacing": "single",
    "defaultAlignment": "left",
    "language": null
  },
  "headings": {
    "1": {
      "wordStyle": "Stats Heading 1"
    },
    "2": {
      "wordStyle": "Stats Heading 2"
    },
    "3": {
      "wordStyle": "Stats Heading 3"
    },
    "4": {
      "wordStyle": "Stats Heading 4"
    },
    "5": {
      "wordStyle": "Stats Heading 5"
    },
    "6": {
      "wordStyle": "Stats Heading 6"
    }
  },
  "styleMap": {
    "title": "Stats Report Title",
    "subtitle": "Stats Report Subtitle",
    "paragraph": "Stats Body",
    "list:bullet": "Stats Bullet",
    "list:ordered": "Stats Numbered",
    "table": "Stats Result Table",
    "tableHeader": "Stats Result Header",
    "figure": "Stats Figure",
    "caption": "Stats Table Caption",
    "blockquote": "Stats Note",
    "codeBlock": "Stats Syntax",
    "toc:1": "Stats Contents Entry",
    "toc:2": "Stats Contents Entry",
    "toc:3": "Stats Contents Entry",
    "footnote": "Stats Footnote"
  },
  "toc": {
    "enabled": true,
    "depth": 2,
    "autoGenerateFromHeadings": true
  },
  "headingNumbering": {
    "auto": false,
    "note": "Headings use direct Word styles only; no automatic multilevel numbering is linked to them."
  },
  "citationStyle": "apa",
  "pageNumbering": "arabic",
  "docFeatures": {
    "coverPage": true
  }
}
