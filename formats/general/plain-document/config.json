{
  "formatId": "general.plain-document",
  "displayName": "Plain document (generic fallback)",
  "phaseId": "general",
  "version": "v2",
  "templateFile": "template.dotx",

  "page": {
    "size": "a4",
    "widthTwips": 11907,
    "heightTwips": 16840,
    "orientation": "portrait",
    "margins": { "topTwips": 1440, "rightTwips": 1440, "bottomTwips": 1440, "leftTwips": 1440 }
  },

  "typography": {
    "defaultFont": "Times New Roman",
    "defaultSizePt": 12,
    "defaultLineSpacing": "single",
    "defaultAlignment": "left",
    "language": null
  },

  "headings": {
    "1": { "wordStyle": "Heading1" },
    "2": { "wordStyle": "Heading2" },
    "3": { "wordStyle": "Heading3" },
    "4": { "wordStyle": "Heading4" },
    "5": { "wordStyle": "Heading5" },
    "6": { "wordStyle": "Heading6" },
    "note": "No font/bold/align overrides specified — apply the named style only and let the template's own built-in formatting for that style stand, since this is a neutral fallback with no specific convention to enforce."
  },

  "caption": { "wordStyle": "Caption" },

  "reference": { "wordStyle": "Normal" },

  "table": { "wordStyle": "TableGrid" },

  "styleMap": {
    "paragraph": "Normal",
    "heading:1": "Heading1",
    "heading:2": "Heading2",
    "heading:3": "Heading3",
    "heading:4": "Heading4",
    "heading:5": "Heading5",
    "heading:6": "Heading6",
    "table": "TableGrid",
    "figureCaption": "Caption",
    "tableCaption": "Caption",
    "reference": "Normal",
    "tocHeading": "TOCHeading",
    "toc:1": "TOC1",
    "toc:2": "TOC2",
    "toc:3": "TOC3"
  },

  "toc": { "enabled": false, "depth": 3, "autoGenerateFromHeadings": true },

  "headingNumbering": { "auto": false, "note": "No numbering scheme imposed; preserve author-typed text as-is." },

  "citationStyle": "none",
  "pageNumbering": "arabic"
}
