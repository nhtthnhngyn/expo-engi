{
  "formatId": "journal-submission.plos-one",
  "displayName": "PLOS ONE submission",
  "phaseId": "journal-submission",
  "version": "v1",
  "templateFile": "template.dotx",
  "page": {
    "size": "letter",
    "widthTwips": 12240,
    "heightTwips": 15840,
    "orientation": "portrait",
    "margins": {
      "topTwips": 1440,
      "rightTwips": 1440,
      "bottomTwips": 1440,
      "leftTwips": 1440
    }
  },
  "typography": {
    "defaultFont": "Arial",
    "defaultSizePt": 12,
    "defaultLineSpacing": "double",
    "defaultAlignment": "left",
    "language": null
  },
  "headings": {
    "1": {
      "wordStyle": "PLOS Heading 1"
    },
    "2": {
      "wordStyle": "PLOS Heading 2"
    },
    "3": {
      "wordStyle": "PLOS Heading 3"
    },
    "4": {
      "wordStyle": "PLOS Heading 4"
    },
    "5": {
      "wordStyle": "PLOS Heading 5"
    },
    "6": {
      "wordStyle": "PLOS Heading 6"
    }
  },
  "styleMap": {
    "title": "PLOS Title",
    "subtitle": "PLOS Authors",
    "paragraph": "PLOS Body",
    "list:bullet": "PLOS Bullet",
    "list:ordered": "PLOS Numbered",
    "table": "PLOS Table",
    "tableHeader": "PLOS Table Header",
    "figure": "PLOS Figure",
    "caption": "PLOS Caption",
    "blockquote": "PLOS Quote",
    "codeBlock": "PLOS Code",
    "toc:1": "PLOS Contents Entry",
    "toc:2": "PLOS Contents Entry",
    "toc:3": "PLOS Contents Entry",
    "footnote": "PLOS Footnote"
  },
  "toc": {
    "enabled": false,
    "depth": 0,
    "autoGenerateFromHeadings": true
  },
  "headingNumbering": {
    "auto": false,
    "note": "Headings use direct Word styles only; no automatic multilevel numbering is linked to them."
  },
  "citationStyle": "vancouver",
  "pageNumbering": "arabic",
  "docFeatures": {
    "coverPage": true,
    "header": "{documentTitle}"
  }
}
