{
  "formatId": "journal-submission.vn-academic-imrad-manuscript",
  "displayName": "VN academic journal manuscript (IMRaD, bilingual abstract)",
  "phaseId": "journal-submission",
  "version": "v3",
  "templateFile": "template.dotx",

  "page": {
    "size": "a4",
    "widthTwips": 11909,
    "heightTwips": 16834,
    "orientation": "portrait",
    "margins": { "topTwips": 1440, "rightTwips": 1440, "bottomTwips": 1440, "leftTwips": 1699 }
  },

  "typography": {
    "defaultFont": "Times New Roman",
    "defaultSizePt": 12,
    "defaultLineSpacing": "single",
    "defaultAlignment": "justify",
    "language": "vi-VN"
  },

  "headings": {
    "method": "directFormatting",
    "note": "No named Word heading styles are used in this format — every heading-like element is bold direct formatting applied on top of the Normal style, not a Heading1/2/3 style.",
    "titleVn": { "wordStyle": "Normal", "font": "Times New Roman", "sizePt": 12, "bold": true, "align": "center" },
    "titleEn": { "wordStyle": "Normal", "font": "Times New Roman", "sizePt": 12, "bold": true, "italic": true, "align": "center" },
    "sectionLabel": { "wordStyle": "Normal", "font": "Times New Roman", "sizePt": 12, "bold": true, "align": "left" },
    "subsectionLabel": { "wordStyle": "Normal", "font": "Times New Roman", "sizePt": 12, "bold": true, "align": "left" }
  },

  "caption": { "wordStyle": "Normal", "font": "Times New Roman", "sizePt": 12, "bold": true, "italic": true, "align": "center" },

  "reference": { "wordStyle": "Normal", "font": "Times New Roman", "sizePt": 12, "bold": false, "align": "left" },

  "table": { "wordStyle": "Normal" },

  "styleMap": {
    "paragraph": "Normal",
    "titleVn": { "style": "Normal", "runFormatting": { "bold": true }, "paragraphFormatting": { "alignment": "center" } },
    "titleEn": { "style": "Normal", "runFormatting": { "bold": true, "italic": true }, "paragraphFormatting": { "alignment": "center" } },
    "authorList": { "style": "Normal", "paragraphFormatting": { "alignment": "center" } },
    "affiliation": { "style": "Normal", "paragraphFormatting": { "alignment": "center" } },
    "sectionHeading": { "style": "Normal", "runFormatting": { "bold": true }, "paragraphFormatting": { "alignment": "left" } },
    "subsectionHeading": { "style": "Normal", "runFormatting": { "bold": true } },
    "table": "Normal",
    "figureCaption": { "style": "Normal", "runFormatting": { "bold": true, "italic": true }, "paragraphFormatting": { "alignment": "center" } },
    "tableCaption": { "style": "Normal", "runFormatting": { "bold": true, "italic": true }, "paragraphFormatting": { "alignment": "center" } },
    "reference": "Normal"
  },

  "toc": { "enabled": false, "depth": 0, "autoGenerateFromHeadings": false },

  "headingNumbering": {
    "auto": false,
    "note": "Flat manuscript, no section numbering scheme at all."
  },

  "citationStyle": "numbered-bracket",
  "pageNumbering": "arabic"
}
