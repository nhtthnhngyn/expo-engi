{
  "formatId": "report-writing.consort",
  "displayName": "CONSORT 2010",
  "phaseId": "report-writing",
  "version": "v1",
  "templateFile": "template.dotx",
  "page": {
    "size": "letter",
    "widthTwips": 12240,
    "heightTwips": 15840,
    "orientation": "portrait",
    "margins": {
      "topTwips": 1440,
      "rightTwips": 1440,
      "bottomTwips": 1440,
      "leftTwips": 1440
    }
  },
  "typography": {
    "defaultFont": "Times New Roman",
    "defaultSizePt": 12,
    "defaultLineSpacing": "double",
    "defaultAlignment": "left",
    "language": null
  },
  "headings": {
    "1": {
      "wordStyle": "Heading 1"
    },
    "2": {
      "wordStyle": "Heading 2"
    },
    "3": {
      "wordStyle": "Heading 3"
    },
    "4": {
      "wordStyle": "Heading 4"
    },
    "5": {
      "wordStyle": "Heading 5"
    },
    "6": {
      "wordStyle": "Heading 6"
    }
  },
  "styleMap": {
    "title": "Title",
    "subtitle": "Subtitle",
    "paragraph": "Body Text",
    "list:bullet": "List Bullet",
    "list:ordered": "List Number",
    "table": "Table Grid Research",
    "tableHeader": "Table Heading",
    "figure": "Figure Caption",
    "caption": "Caption",
    "checklistItem": "CONSORT Checklist Row",
    "blockquote": "Quote",
    "codeBlock": "Code Block",
    "toc:1": "TOC Entry",
    "toc:2": "TOC Entry",
    "toc:3": "TOC Entry",
    "footnote": "Footnote Text"
  },
  "toc": {
    "enabled": true,
    "depth": 2,
    "autoGenerateFromHeadings": true
  },
  "headingNumbering": {
    "auto": false,
    "note": "Headings use direct Word styles only; no automatic multilevel numbering is linked to them."
  },
  "citationStyle": "vancouver",
  "pageNumbering": "arabic",
  "docFeatures": {
    "coverPage": true,
    "header": "{documentTitle}",
    "footer": "CONSORT 2010 — {projectId}"
  }
}
