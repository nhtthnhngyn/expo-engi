{
  "formatId": "report-writing.prisma",
  "displayName": "PRISMA 2020 (systematic reviews)",
  "phaseId": "report-writing",
  "version": "v1",
  "templateFile": "template.dotx",
  "page": {
    "size": "letter",
    "widthTwips": 12240,
    "heightTwips": 15840,
    "orientation": "portrait",
    "margins": {
      "topTwips": 1440,
      "rightTwips": 1440,
      "bottomTwips": 1440,
      "leftTwips": 1440
    }
  },
  "typography": {
    "defaultFont": "Times New Roman",
    "defaultSizePt": 12,
    "defaultLineSpacing": "double",
    "defaultAlignment": "left",
    "language": null
  },
  "headings": {
    "1": {
      "wordStyle": "PRISMA Heading 1"
    },
    "2": {
      "wordStyle": "PRISMA Heading 2"
    },
    "3": {
      "wordStyle": "PRISMA Heading 3"
    },
    "4": {
      "wordStyle": "PRISMA Heading 4"
    },
    "5": {
      "wordStyle": "PRISMA Heading 5"
    },
    "6": {
      "wordStyle": "PRISMA Heading 6"
    }
  },
  "styleMap": {
    "title": "PRISMA Title",
    "subtitle": "PRISMA Subtitle",
    "paragraph": "PRISMA Body",
    "list:bullet": "PRISMA Bullet",
    "list:ordered": "PRISMA Numbered",
    "table": "PRISMA Table",
    "tableHeader": "PRISMA Table Header",
    "figure": "PRISMA Figure",
    "caption": "PRISMA Caption",
    "checklistItem": "PRISMA Checklist Item",
    "blockquote": "PRISMA Quote",
    "codeBlock": "PRISMA Code",
    "toc:1": "PRISMA Contents Entry",
    "toc:2": "PRISMA Contents Entry",
    "toc:3": "PRISMA Contents Entry",
    "footnote": "PRISMA Footnote"
  },
  "toc": {
    "enabled": true,
    "depth": 2,
    "autoGenerateFromHeadings": true
  },
  "headingNumbering": {
    "auto": false,
    "note": "Headings use direct Word styles only; no automatic multilevel numbering is linked to them."
  },
  "citationStyle": "vancouver",
  "pageNumbering": "arabic",
  "docFeatures": {
    "coverPage": false
  }
}
