{
  "formatId": "report-writing.prisma",
  "standard": "PRISMA 2020",
  "checks": [
    { "id": "flow-diagram-required", "description": "The PRISMA flow diagram (required) is present.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "Records identified" } },
    { "id": "flow-diagram-count", "description": "Stage counts render verbatim.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "Studies included in review (n = 14)" } },
    { "id": "checklist-required", "description": "The prisma-checklist section (required) is present.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "prespecified hypotheses" } },
    { "id": "item-3-numbered", "description": "Checklist item 3 is numbered.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "3. " } }
  ]
}
