{
  "formatId": "report-writing.strobe",
  "standard": "STROBE",
  "checks": [
    { "id": "methods-present", "description": "Methods (required) is present.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "4,200 hospital shift workers" } },
    { "id": "results-present", "description": "Results (required) is present.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "HR 1.4" } },
    { "id": "checklist-required", "description": "The strobe-checklist section (required) is present.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "commonly used term in the title" } },
    { "id": "item-1a-numbered", "description": "Checklist item 1a keeps its letter suffix.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "1a. " } },
    { "id": "item-12-numbered", "description": "Checklist item 12 is numbered without a suffix.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "12. " } },
    { "id": "no-cover-page", "description": "docProperties.coverPage = false, unlike CONSORT and the protocol default.", "assert": { "kind": "notContains", "part": "word/document.xml", "value": "Project: " } }
  ]
}
