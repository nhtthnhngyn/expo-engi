{
  "formatId": "journal-submission.elsevier",
  "standard": "Elsevier generic manuscript template",
  "checks": [
    { "id": "abstract-required", "description": "abstract (required) present.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "economic evaluation" } },
    { "id": "keywords-required", "description": "keywords (required) present.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "cost-effectiveness; early mobilisation" } },
    { "id": "doi-required", "description": "declaration-of-interest (required) present.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "no conflict of interest" } },
    { "id": "cover-page-present", "description": "docProperties.coverPage = true.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "Cost-effectiveness of early mobilisation" } }
  ]
}
