{
  "formatId": "journal-submission.ieee",
  "standard": "IEEE Transactions manuscript template",
  "checks": [
    { "id": "abstract-required", "description": "abstract (required) present.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "low-power wearable system" } },
    { "id": "index-terms-required", "description": "index-terms (required) present.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "Wearable sensors, critical care" } },
    { "id": "references-required", "description": "references (required) present.", "assert": { "kind": "contains", "part": "word/document.xml", "value": "Crit. Care Med., 2009" } },
    { "id": "no-cover-page", "description": "docProperties.coverPage = false.", "assert": { "kind": "notContains", "part": "word/document.xml", "value": "Project: " } },
    { "id": "no-toc", "description": "docProperties.tocDepth = 0 emits no TOC field.", "assert": { "kind": "notContains", "part": "word/document.xml", "value": "w:instrText" } }
  ]
}
