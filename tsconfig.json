{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "core/**/*.ts",
    "schemas/**/*.ts",
    "normalizer/**/*.ts",
    "validator/**/*.ts",
    "format-registry/**/*.ts",
    "renderer/**/*.ts",
    "api/**/*.ts",
    "template-extraction/**/*.ts",
    "admin-ui/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ]
}
