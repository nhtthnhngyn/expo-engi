        "type": "codeBlock",
        "content": [
          {
            "type": "text",
            "text": "def feasibility_verdict(required_n, cases_per_month, months, eligible_rate, consent_rate):\n    \"\"\"Pure function mirroring the engine's own sample-size feasibility check.\"\"\"\n    realistic_yield = cases_per_month * months * eligible_rate * consent_rate\n    ratio = realistic_yield / required_n\n    if ratio >= 1.2:\n        return \"GREEN\", ratio\n    if ratio >= 1.0:\n        return \"YELLOW\", ratio\n    return \"RED\", ratio\n\nprint(feasibility_verdict(96, 25, 8, 0.60, 0.85))\n# -> (\"YELLOW\", 1.0625)"
          }
        ]
      }
    ],
