{
  "name": "export-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Universal research-document export engine: ProseMirror JSON -> Canonical IR -> .docx, driven by a data-only format registry.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:schemas": "tsx tools/validate-schemas.ts",
    "build:templates": "tsx tools/make-templates.ts && tsx tools/build-templates-from-facts.ts",
    "build:registry": "tsx tools/build-registry.ts",
    "lint:stylemap": "tsx tools/style-map-lint-cli.ts",
    "render:fixture": "tsx tools/render-fixture.ts",
    "render:skeleton": "tsx tools/render-skeleton.ts",
    "extract:outline": "tsx tools/extract-outline.ts",
    "admin-ui": "tsx admin-ui/server.ts",
    "api": "tsx api/server.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
